# Für `pnpm dev:server` auf der eigenen Maschine.
# Der Server bindet auf loopback; der Reverse Proxy ist das, was nach aussen zeigt.
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://nebelwacht:nebelwacht@localhost:5432/nebelwacht
# Nur hinter einem Reverse Proxy setzen — sonst glaubt der Server jedem
# gefälschten X-Forwarded-For.
# TRUST_PROXY=loopback

# Für docker compose (lokal wie auf dem Server), siehe docs/Betrieb.md.
# POSTGRES_PASSWORD=
# IMAGE=ghcr.io/mrfudog/atlas-mentis:main
# APP_PORT=8080
