# Caddy vor den beiden Umgebungen. Die Namen kommen aus .env neben der
# compose.yml (PROD_HOST, DEV_HOST); beide müssen per DNS auf den Server
# zeigen, sonst bekommt Caddy kein Zertifikat.
{
	email {$ACME_EMAIL}
}

# Der Live-Kanal (T-116, `GET /api/live`) ist ein Strom aus Server-Sent
# Events: er wird nicht gepackt (das Packen sammelt, bevor es schickt) und
# sofort durchgereicht (`flush_interval -1`). Ein Zeitlimit für die Antwort
# setzt Caddy von sich aus keines; die Anwendung schickt alle 25 s ein
# Lebenszeichen und schliesst nach 15 min selbst, das Gerät kommt mit
# `Last-Event-ID` wieder.
(atlas) {
	@gepackt not path /api/live
	encode @gepackt zstd gzip
	reverse_proxy {args[0]} {
		flush_interval -1
	}
}

{$PROD_HOST} {
	import atlas 127.0.0.1:8080
}

{$DEV_HOST} {
	# Die Testinstanz ist nicht für die Öffentlichkeit: Suchmaschinen
	# draussen halten. Wer sie ganz zumachen will, nimmt basic_auth dazu:
	#   basic_auth { <name> <hash aus: docker compose exec caddy caddy hash-password> }
	header X-Robots-Tag "noindex, nofollow"
	import atlas 127.0.0.1:8081
}
