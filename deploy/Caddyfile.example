# /etc/caddy/Caddyfile — Caddy holt und erneuert die Zertifikate selbst.
# Beide Namen müssen per DNS (A/AAAA) auf den Server zeigen.

atlas.example.ch {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

dev.atlas.example.ch {
	encode zstd gzip
	# Die Testinstanz ist nicht für die Öffentlichkeit: Suchmaschinen
	# draussen halten. Wer sie ganz zumachen will, nimmt basic_auth dazu.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 127.0.0.1:8081
}
