{
  "name": "atlas-mentis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @nw/model build && pnpm --filter @nw/registry build && pnpm --filter @nw/server build && pnpm --filter web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "dev:web": "pnpm --filter web start",
    "dev:server": "pnpm --filter @nw/server dev",
    "migrate": "pnpm --filter @nw/server migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.8"
  }
}
